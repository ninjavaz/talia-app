{
  "compileOnSave": false,
  "compilerOptions": {
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "ES2022",
    "module": "preserve",
    "paths": {
      "@ui/button": ["./src/app/ui/button/src/index.ts"],
      "@ui/utils": ["./src/app/ui/utils/src/index.ts"],
      "@ui/card": ["./src/app/ui/card/src/index.ts"],
      "@ui/input": ["./src/app/ui/input/src/index.ts"],
      "@ui/label": ["./src/app/ui/label/src/index.ts"],
      "@ui/checkbox": ["./src/app/ui/checkbox/src/index.ts"],
      "@ui/progress": ["./src/app/ui/progress/src/index.ts"],
      "@ui/separator": ["./src/app/ui/separator/src/index.ts"],
      "@ui/dialog": ["./src/app/ui/dialog/src/index.ts"],
      "@ui/switch": ["./src/app/ui/switch/src/index.ts"],
      "@ui/toggle-group": ["./src/app/ui/toggle-group/src/index.ts"],
      "@ui/toggle": ["./src/app/ui/toggle/src/index.ts"],
      "@ui/sonner": ["./src/app/ui/sonner/src/index.ts"]
    }
  },
  "angularCompilerOptions": {
    "enableI18nLegacyMessageIdFormat": false,
    "strictInjectionParameters": true,
    "strictInputAccessModifiers": true
  },
  "files": [],
  "references": [
    {
      "path": "./tsconfig.app.json"
    },
    {
      "path": "./tsconfig.spec.json"
    }
  ]
}
