{
  "compileOnSave": false,
  "compilerOptions": {
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "ES2022",
    "module": "preserve",
    "paths": {
      "@ui/button": ["./projects/ui/helm/button/src/index.ts"],
      "@ui/utils": ["./projects/ui/helm/utils/src/index.ts"],
      "@ui/card": ["./projects/ui/helm/card/src/index.ts"],
      "@ui/input": ["./projects/ui/helm/input/src/index.ts"],
      "@ui/label": ["./projects/ui/helm/label/src/index.ts"],
      "@ui/checkbox": ["./projects/ui/helm/checkbox/src/index.ts"],
      "@ui/progress": ["./projects/ui/helm/progress/src/index.ts"],
      "@ui/separator": ["./projects/ui/helm/separator/src/index.ts"],
      "@ui/dialog": ["./projects/ui/helm/dialog/src/index.ts"],
      "@ui/switch": ["./projects/ui/helm/switch/src/index.ts"],
      "@ui/toggle-group": ["./projects/ui/helm/toggle-group/src/index.ts"],
      "@ui/toggle": ["./projects/ui/helm/toggle/src/index.ts"],
      "@ui/sonner": ["./projects/ui/helm/sonner/src/index.ts"],
      "@talia/ui": ["./projects/ui/src/public-api.ts"]
    }
  },
  "angularCompilerOptions": {
    "enableI18nLegacyMessageIdFormat": false,
    "strictInjectionParameters": true,
    "strictInputAccessModifiers": true
  },
  "files": [],
  "references": [
    {
      "path": "./tsconfig.app.json"
    },
    {
      "path": "./tsconfig.spec.json"
    },
    {
      "path": "./projects/ui/tsconfig.lib.json"
    },
    {
      "path": "./projects/ui/tsconfig.spec.json"
    }
  ]
}
