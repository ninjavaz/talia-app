# Copy to .env on the server and fill in. Never commit .env (it holds secrets).

# Address users open (links in e-mails). Mikrus: https://<server>.mikrus.cloud
PUBLIC_URL=https://example.mikrus.cloud

# Database password: a long random string, e.g. `openssl rand -base64 32`
DB_PASSWORD=

# Signs the registration bot-check challenges: a long random string (`openssl rand -base64 48`)
ALTCHA_HMAC_SECRET=

# Web Push keys (scripts\vapid-keys.cmd prints a pair) and a contact for the push services
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# SMTP of an e-mail provider (registration needs a confirmed e-mail). Empty = no e-mails are sent.
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=MyTalia <no-reply@example.com>

# Web server. Behind the Mikrus HTTPS proxy keep :80; with an own domain: the domain name (and publish 443).
SITE_ADDRESS=:80
# Address(es) of the proxy in front of Caddy, see docs/deploy.md (rate limits use the client IP)
TRUSTED_PROXIES=private_ranges
WEB_PORT=80

# Image version: latest, or a commit SHA to pin/roll back
TAG=latest
