# Web server of Talia: serves the Angular app and proxies /api to the backend.
#
# SITE_ADDRESS
#   :80          (default) plain HTTP behind the Mikrus HTTPS proxy (https://<server>.mikrus.cloud)
#   mytalia.app  own domain: Caddy gets a Let's Encrypt certificate itself (publish ports 80 and 443)
# TRUSTED_PROXIES
#   addresses of the proxy in front of Caddy (the Mikrus proxy); only from them the client IP in
#   X-Forwarded-For is believed. The backend's per-IP rate limits depend on it (see docs/deploy.md).
# BACKEND_ADDRESS
#   where the backend listens (127.0.0.1:8080 with Caddy in the host network)
{
	admin off
	servers {
		trusted_proxies static {$TRUSTED_PROXIES:private_ranges}
		# read X-Forwarded-For from the right, skipping trusted proxies: a client cannot spoof its address
		trusted_proxies_strict
		client_ip_headers X-Forwarded-For
	}
}

{$SITE_ADDRESS::80} {
	log {
		output stdout
		format console
	}

	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
		# Angular adds component styles inline; the ALTCHA widget solves its challenge in a blob: worker
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; worker-src 'self' blob:; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
		-Server
	}

	handle /api/* {
		reverse_proxy {$BACKEND_ADDRESS:backend:8080} {
			# exactly one address, determined above: the backend takes it as the client IP
			header_up X-Forwarded-For {client_ip}
		}
	}

	handle {
		root * /srv
		# file names with a content hash never change; everything else (index.html, service worker) is revalidated
		@hashed path_regexp -[A-Za-z0-9_]{8}\.(js|css)$
		header @hashed Cache-Control "public, max-age=31536000, immutable"
		header ?Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
